@implements IDisposable
@inject TripService Trip

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 text-slate-950 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
        <a href="" class="font-serif text-xl font-bold tracking-tight">
            <span class="mr-2">CE.</span><span class="hidden sm:inline">Cebu Explorer</span>
        </a>

        <nav class="flex items-center gap-1 text-sm font-semibold">
            <NavLink href="" Match="NavLinkMatch.All" ActiveClass="bg-slate-950! text-white"
                     class="relative rounded-full px-3 py-2 transition hover:bg-slate-200/70 sm:px-4">Home</NavLink>

            <NavLink href="explore" ActiveClass="bg-slate-950! text-white"
                     class="relative rounded-full px-3 py-2 transition hover:bg-slate-200/70 sm:px-4">Explore</NavLink>

            <NavLink href="trip" ActiveClass="bg-slate-950! text-white"
                     class="relative rounded-full px-3 py-2 transition hover:bg-slate-200/70 sm:px-4">
                <span class="hidden sm:inline">My Trip</span><span class="sm:hidden">Trip</span>
                @if (Trip.Count > 0)
                {
                    <span class="ml-1.5 rounded-full bg-orange-500 px-1.5 py-0.5 text-[0.65rem] text-white">@Trip.Count</span>
                }
            </NavLink>
        </nav>
    </div>
</header>

@code {
    protected override void OnInitialized() => Trip.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Trip.OnChange -= Refresh;
}