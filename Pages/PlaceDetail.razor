@page "/explore/{Id}"
@implements IDisposable
@inject PlaceService Places
@inject TripService Trip

@if (place is null)
{
    <PageTitle>Place not found</PageTitle>
    <div class="py-24 text-center">
        <h1 class="font-serif text-4xl font-bold text-cyan-950">Place not found</h1>
        <a href="explore" class="mt-4 inline-block font-semibold text-cyan-700">Return to Explore</a>
    </div>
}
else
{
    <PageTitle>@place.Name</PageTitle>

    <div>
        <a href="explore" class="inline-flex items-center gap-2 font-semibold text-cyan-700 hover:text-orange-600">← Back to Explore</a>

        <section class="mt-7 grid items-stretch gap-8 md:grid-cols-5">
            <div class="relative min-h-96 overflow-hidden rounded-[2rem] shadow-xl md:col-span-2">
                <img src="@place.Cover" alt="@place.Name" class="absolute inset-0 h-full w-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent"></div>
                <span class="absolute bottom-6 left-6 inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-slate-950 shadow-xl backdrop-blur">
                    <Icon Name="map-pin" Size="16" />@place.Area
                </span>
            </div>

            <div class="md:col-span-3">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-orange-600">@place.Category</p>
                <h1 class="mt-2 font-serif text-4xl font-normal tracking-tight text-slate-950 md:text-6xl">@place.Name</h1>
                <p class="mt-3 flex items-center gap-2 text-slate-500"><Icon Name="map-pin" Size="17" /> @place.Area</p>
                <p class="mt-6 leading-7 text-slate-700">@place.Description</p>

                <div class="mt-6 grid grid-cols-2 gap-3">
                    <div class="rounded-2xl bg-slate-50 p-4 shadow-sm">
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Best time</p>
                        <p class="mt-2 font-bold text-cyan-950">@place.BestTime</p>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4 shadow-sm">
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Entrance</p>
                        <p class="mt-2 font-bold text-cyan-950">@place.Entrance</p>
                    </div>
                </div>

                <div class="mt-7">
                    <h2 class="font-serif text-xl font-bold text-cyan-950">Local tips</h2>
                    <ul class="mt-3 space-y-2 text-sm text-slate-600">
                        @foreach (var tip in place.Tips)
                        {
                            <li class="flex gap-2">
                                <Icon Name="lightbulb" Size="16" Class="mt-0.5 shrink-0 text-orange-500" />
                                <span>@tip</span>
                            </li>
                        }
                    </ul>
                </div>

                @if (Trip.Has(place.Id))
                {
                    <button @onclick="() => Trip.Toggle(place.Id)"
                            class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-200 px-5 py-3.5 font-bold text-slate-700 transition hover:bg-slate-300 sm:w-auto">
                        <Icon Name="check" Size="18" /> In your trip (click to remove)
                    </button>
                }
                else
                {
                    <button @onclick="() => Trip.Toggle(place.Id)"
                            class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-orange-500 px-5 py-3.5 font-bold text-white shadow-lg shadow-orange-200 transition hover:bg-orange-600 sm:w-auto">
                        <Icon Name="plus" Size="18" /> Add to my trip
                    </button>
                }
            </div>
        </section>

        @if (related.Count > 0)
        {
            <section class="mt-16 border-t border-cyan-900/10 pt-10">
                <h2 class="font-serif text-3xl font-bold text-cyan-950">More in @place.Category</h2>
                <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var p in related)
                    {
                        <PlaceCard Place="p" />
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private Place? place;
    private List<Place> related = new();

    protected override void OnInitialized() => Trip.OnChange += Refresh;

    protected override void OnParametersSet()
    {
        place = Places.GetById(Id);
        related = place is null
            ? new()
            : Places.All.Where(x => x.Category == place.Category && x.Id != place.Id).Take(3).ToList();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Trip.OnChange -= Refresh;
}