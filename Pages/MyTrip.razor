@page "/trip"
@implements IDisposable
@inject PlaceService Places
@inject TripService Trip

<PageTitle>My Trip</PageTitle>

<div>
    <div class="flex items-end justify-between">
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-cyan-600">Your Cebu plan</p>
            <h1 class="mt-2 font-serif text-4xl font-bold text-cyan-950">My Trip</h1>
        </div>
        @if (saved.Count > 0)
        {
            <button @onclick="Trip.Clear" class="font-semibold text-red-600 hover:text-red-700">Clear all</button>
        }
    </div>

    @if (saved.Count == 0)
    {
        <div class="mt-10 rounded-3xl bg-slate-50 px-6 py-20 text-center shadow-sm">
            <Icon Name="luggage" Size="64" Class="mx-auto text-slate-400" />
            <h2 class="mt-5 font-serif text-2xl font-bold text-cyan-950">Your trip is empty.</h2>
            <p class="mx-auto mt-2 max-w-md text-slate-500">Save the places that inspire you and build your perfect Cebu day.</p>
            <a href="explore" class="mt-7 inline-block rounded-full bg-cyan-600 px-6 py-3 font-bold text-white hover:bg-cyan-700">Start exploring</a>
        </div>
    }
    else
    {
        <p class="mt-3 text-slate-500">@saved.Count stop@(saved.Count == 1 ? "" : "s") planned</p>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
            @for (var i = 0; i < saved.Count; i++)
            {
                var place = saved[i];
                var stop = i + 1;
                <div class="group relative min-h-72 overflow-hidden rounded-[2rem] shadow-xl">
                    <img src="@place.Cover" alt="" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
                    <div class="absolute inset-x-0 bottom-0 p-5 text-white">
                        <p class="text-xs font-bold text-orange-400">STOP @stop.ToString("00")</p>
                        <a href="explore/@place.Id" class="mt-1 block font-serif text-2xl">@place.Name</a>
                        <p class="mt-1 flex items-center gap-1.5 text-sm text-white/70">
                            <Icon Name="map-pin" Size="14" />@place.Area · Best: @place.BestTime
                        </p>
                        <button aria-label="Remove @place.Name" @onclick="() => Trip.Toggle(place.Id)"
                                class="absolute bottom-5 right-5 grid h-10 w-10 place-items-center rounded-full bg-white text-slate-950 transition hover:bg-red-500 hover:text-white">
                            <Icon Name="x" Size="17" />
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Place> saved => Trip.Ids
        .Select(id => Places.GetById(id))
        .Where(p => p is not null)
        .Select(p => p!)
        .ToList();

    protected override void OnInitialized() => Trip.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Trip.OnChange -= Refresh;
}